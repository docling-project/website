"""The four core value propositions."""

from pyjsx import jsx, JSX

from website.data.product import VALUES
from .icons import arrow_right, external_icon, icon_ai, icon_model, icon_private, icon_structure
from .ui import SectionHeader


_ICONS = {
    "structure": icon_structure,
    "model": icon_model,
    "private": icon_private,
    "ai": icon_ai,
}


def CapabilityGrid(children) -> JSX:
    return (
        <section class="section" id="overview">
            <div class="container">
                <SectionHeader
                    label="Why Docling"
                    title="Built for structure, not just text"
                    display={True}
                />

                <div class="grid grid--4 capability-grid">
                    {[
                        <div class="card">
                            <span class="card-icon">{_ICONS[value.id]()}</span>
                            <h3 class="card-title">{value.title}</h3>
                            <p class="card-body">{value.body}</p>
                            {
                                <a
                                    class="card-link"
                                    href={value.link_href}
                                    target={"_blank" if value.link_href.startswith("http") else None}
                                    rel={"noopener noreferrer" if value.link_href.startswith("http") else None}
                                >
                                    {value.link_label}
                                    {external_icon() if value.link_href.startswith("http") else arrow_right()}
                                </a>
                                if value.link_href
                                else <></>
                            }
                        </div>
                        for value in VALUES
                    ]}
                </div>
            </div>
        </section>
    )
