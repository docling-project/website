"""The scale/output matrix.

Scale (one document at a time vs. in bulk) against what you want back (full
conversion vs. schema extraction). A navigation aid for "which call do I make",
not an exhaustive list of what Docling can do.
"""

from pyjsx import jsx, JSX

from website.data.product import MATRIX, MATRIX_APPLICATIONS, MATRIX_MODES
from .ui import SectionHeader


def _cell(mode: str, application: str):
    for cell in MATRIX:
        if cell.mode == mode and cell.application == application:
            return cell
    return None


def Matrix(children) -> JSX:
    return (
        <section class="section" id="modes">
            <div class="container">
                <SectionHeader
                    label="Ad-hoc to bulk"
                    title="One document or a whole corpus — you're covered"
                    display={True}
                />

                <p class="section-lede">
                    Two questions decide how you call Docling: do you need one document
                    right now or a whole corpus, and do you want the whole document
                    converted or just specific fields pulled against your own schema?
                    Conversion hands back a DoclingDocument (Markdown, JSON, HTML or
                    DocLang); extraction hands back records shaped like the schema you
                    define. And this grid isn't the limit — any converted document can
                    also be chunked, enriched or re-serialized downstream.
                </p>

                <div class="matrix">
                    <div class="matrix-corner" aria-hidden="true"></div>
                    {[
                        <div class="matrix-col-head">{application}</div>
                        for application in MATRIX_APPLICATIONS
                    ]}

                    {[
                        row
                        for mode in MATRIX_MODES
                        for row in [
                            <div class="matrix-row-head">{mode}</div>,
                            *[
                                <div class="matrix-cell">
                                    <h3 class="matrix-cell-title">{_cell(mode, application).title}</h3>
                                    <p class="matrix-cell-body">{_cell(mode, application).body}</p>
                                    <code class="matrix-cell-code">{_cell(mode, application).example}</code>
                                </div>
                                for application in MATRIX_APPLICATIONS
                            ],
                        ]
                    ]}
                </div>
            </div>
        </section>
    )
