"""The scale/output matrix.

Scale (one document at a time vs. in bulk) against what you want back (full
conversion vs. schema extraction). A navigation aid for "which call do I make",
not an exhaustive list of what Docling can do.
"""

from pyjsx import jsx, JSX

from website.data.product import MATRIX, MATRIX_APPLICATIONS, MATRIX_MODES, MODE_TAGLINES
from .ui import SectionHeader


def _cell(mode: str, application: str):
    for cell in MATRIX:
        if cell.mode == mode and cell.application == application:
            return cell
    return None


def Matrix(children) -> JSX:
    return (
        <section class="section" id="modes">
            <div class="container">
                <SectionHeader
                    label="Different jobs, familiar API"
                    title="One document or a million, in the shape you need"
                    display={True}
                />

                <p class="section-lede">
                    Whether it's one document right now or all of them at once, a
                    standard format or fields extracted into your own schema — Docling
                    is ready for it.
                </p>

                <div class="matrix">
                    <div class="matrix-corner" aria-hidden="true"></div>
                    {[
                        <div class="matrix-col-head">{application}</div>
                        for application in MATRIX_APPLICATIONS
                    ]}

                    {[
                        row
                        for mode in MATRIX_MODES
                        for row in [
                            <div class="matrix-row-head">
                                <span class="matrix-row-head-title">{mode}</span>
                                <span class="matrix-row-head-sub">{MODE_TAGLINES[mode]}</span>
                            </div>,
                            *[
                                <div class="matrix-cell">
                                    <h3 class="matrix-cell-title">{_cell(mode, application).title}</h3>
                                    <p class="matrix-cell-body">{_cell(mode, application).body}</p>
                                    <code class="matrix-cell-code">{_cell(mode, application).example}</code>
                                </div>
                                for application in MATRIX_APPLICATIONS
                            ],
                        ]
                    ]}
                </div>
            </div>
        </section>
    )
