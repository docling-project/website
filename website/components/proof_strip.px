"""Proof strip: live repository counts beside properties that do not drift.

Counts are placeholders in the HTML and filled in by `js/github.js`; the markup
reserves their width so arriving numbers cannot shift the layout.
"""

from pyjsx import jsx, JSX

from website.data.proof import PROOF_FACTS, PROOF_ITEMS
from .icons import github_icon


def _Stat(item) -> JSX:
    value = (
        <span class="stat-value" data-github={item.live_key}>{item.value}</span>
        if item.live_key
        else <span class="stat-value">{item.value}</span>
    )

    body = (
        <>
            {value}
            <span class="stat-label">{item.label}</span>
        </>
    )

    if item.href:
        return (
            <a class="stat" href={item.href} target="_blank" rel="noopener noreferrer">
                {body}
            </a>
        )
    return <div class="stat">{body}</div>


def ProofStrip(children) -> JSX:
    return (
        <section class="section--band proof-strip" aria-label="Project facts">
            <div class="container proof-inner">
                <div class="proof-stats">
                    <span class="proof-mark" aria-hidden="true">{github_icon()}</span>
                    {[_Stat(item) for item in PROOF_ITEMS]}
                </div>

                <ul class="proof-facts">
                    {[
                        <li>
                            {
                                <a href={fact.href}>
                                    <strong>{fact.value}</strong>
                                    <span>{fact.label}</span>
                                </a>
                                if fact.href
                                else <div>
                                    <strong>{fact.value}</strong>
                                    <span>{fact.label}</span>
                                </div>
                            }
                        </li>
                        for fact in PROOF_FACTS
                    ]}
                </ul>
            </div>
        </section>
    )
