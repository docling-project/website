"""Small shared page pieces and the simple standalone pages."""

from pyjsx import jsx, JSX

from website.components.ui import Button, SectionHeader  # type: ignore

from .page import Page


def AnnouncementBanner(children=None) -> JSX:
    return (
        <div class="announcement">
            <p>
                Managed Docling SaaS announced by IBM —{" "}
                <a
                    href="https://www.ibm.com/account/reg/us-en/signup?formid=urx-54322&utm_source=docling.ai&utm_medium=banner&utm_campaign=free_trial&utm_content=site_banner"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    try Docling for IBM watsonx for free
                </a>
            </p>
        </div>
    )


def ComingSoonPage(title: str, path: str = "/") -> JSX:
    return (
        <Page title={f"{title} — Docling"} path={path} active={path}>
            <div class="container page-header">
                <p class="section-label">Docling</p>
                <h1 class="page-title">{title}</h1>
                <p class="page-subtitle">This page is being written.</p>
            </div>

            <div class="container section">
                <Button href="/" variant="secondary">Back to the homepage</Button>
            </div>
        </Page>
    )


def CommunityPage() -> JSX:
    return (
        <Page
            title="Community — Docling"
            description="Talk to the Docling community on the LF AI & Data Slack, GitHub and Hugging Face."
            path="/community/"
            active="/community/"
        >
            <div class="container page-header">
                <p class="section-label">Community</p>
                <h1 class="page-title">Come and build with us</h1>
                <p class="page-subtitle">
                    Docling is developed in the open as an LF AI &amp; Data project.
                </p>
            </div>

            <div class="container section prose" id="slack">
                <h2>Slack</h2>
                <p>
                    The day-to-day technical conversation happens on the LF AI &amp; Data
                    Slack workspace.
                </p>
                <p>
                    <Button href="https://communityinviter.com/apps/lfaifoundation/join-lf-ai-and-data-foundation" external={True}>
                        Join the LF AI &amp; Data Slack
                    </Button>
                </p>
                <p>Once you are in the workspace, find us in:</p>
                <ul>
                    <li>
                        <a
                            href="https://lfaifoundation.slack.com/archives/docling-technical-discuss/"
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            #docling-technical-discuss
                        </a>
                    </li>
                </ul>

                <h2>GitHub</h2>
                <p>
                    Issues, discussions and pull requests all live in the{" "}
                    <a
                        href="https://github.com/docling-project/docling"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        main repository
                    </a>.
                </p>

                <h2>Hugging Face</h2>
                <p>
                    Models and datasets are published under the{" "}
                    <a
                        href="https://huggingface.co/docling-project"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        docling-project
                    </a>{" "}
                    organisation.
                </p>
            </div>
        </Page>
    )
