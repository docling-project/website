"""The full ecosystem listing."""

from pyjsx import jsx, JSX

from website.components.ecosystem import EcosystemGroups  # type: ignore

from .page import Page


def EcosystemPage() -> JSX:
    return (
        <Page
            title="Ecosystem — Docling"
            description={(
                "Docling integrations across frameworks, agents, data pipelines, "
                "infrastructure and retrieval — each linking to its documentation."
            )}
            path="/ecosystem/"
            active="/ecosystem/"
        >
            <div class="container page-header">
                <p class="section-label">Ecosystem</p>
                <h1 class="page-title">It already fits your stack</h1>
                <p class="page-subtitle">
                    Docling is a library, not a platform you have to move into. It plugs
                    into the frameworks, agents, pipelines and infrastructure you are
                    already running.
                </p>
            </div>

            <div class="container section">
                <EcosystemGroups />
            </div>
        </Page>
    )
