"""The homepage.

Section composition only. The order follows the strategy's recommended
hierarchy: promise, proof, quickstart, local-to-scale journey, capabilities,
use cases, deployment, evidence, and community last.
"""

from pyjsx import jsx, JSX

from website.components.capability_grid import CapabilityGrid  # type: ignore
from website.components.deployment_continuum import DeploymentContinuum  # type: ignore
from website.components.document_demo import DocumentDemo  # type: ignore
from website.components.ecosystem import Ecosystem  # type: ignore
from website.components.hero import Hero  # type: ignore
from website.components.matrix import Matrix  # type: ignore
from website.components.portability import Portability  # type: ignore
from website.components.quickstart import Quickstart  # type: ignore
from website.components.sections import FinalCTA, Latest, RunRoutes  # type: ignore
from website.components.use_case_grid import UseCaseGrid  # type: ignore

from .components import AnnouncementBanner  # type: ignore
from .page import Page


def HomePage() -> JSX:
    return (
        <Page
            path="/"
            active="/"
            banner={<AnnouncementBanner />}
        >
            <Hero />
            <Quickstart />
            <DocumentDemo />
            <Portability />
            <CapabilityGrid />
            <Matrix />
            <DeploymentContinuum />
            <UseCaseGrid limit={2} />
            <RunRoutes />
            <Ecosystem />
            <Latest />
            <FinalCTA />
        </Page>
    )
