"""The page shell.

Carries per-page title, description, canonical URL and social image, preloads
the critical font, and wraps every page in the shared header/footer with a skip
link ahead of both.
"""

import json

from pyjsx import HTMLDontEscape, jsx, JSX

from website.components.footer import Footer  # type: ignore
from website.components.header import Header  # type: ignore


SITE_NAME = "Docling"
SITE_URL = "https://docling.ai"

DEFAULT_TITLE = "Docling — Turn complex documents into structured data your AI can use"
DEFAULT_DESCRIPTION = (
    "Docling is open-source document intelligence. Preserve layout, reading "
    "order, tables, formulas, pictures and provenance in one document model — "
    "locally, as a service, or on private infrastructure."
)
DEFAULT_IMAGE = "/img/og.png"


def _organization_schema() -> dict:
    return {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "Docling",
        "applicationCategory": "DeveloperApplication",
        "operatingSystem": "Linux, macOS, Windows",
        "url": SITE_URL,
        "license": "https://github.com/docling-project/docling/blob/main/LICENSE",
        "offers": {"@type": "Offer", "price": "0", "priceCurrency": "USD"},
        "description": DEFAULT_DESCRIPTION,
    }


def Page(
    children,
    title: str | None = None,
    description: str | None = None,
    path: str = "/",
    image: str | None = None,
    active: str = "",
    schema: dict | None = None,
    banner=None,
) -> JSX:
    page_title = title or DEFAULT_TITLE
    page_description = description or DEFAULT_DESCRIPTION
    canonical = SITE_URL + (path if path.startswith("/") else "/" + path)
    social_image = SITE_URL + (image or DEFAULT_IMAGE)
    structured = json.dumps(schema or _organization_schema())

    return (
        <html lang="en" id="root">
            <head>
                <meta charset="utf-8" />
                <meta name="viewport" content="width=device-width, initial-scale=1" />

                <title>{page_title}</title>
                <meta name="description" content={page_description} />
                <link rel="canonical" href={canonical} />
                <meta name="robots" content="index, follow" />

                <meta property="og:type" content="website" />
                <meta property="og:site_name" content={SITE_NAME} />
                <meta property="og:title" content={page_title} />
                <meta property="og:description" content={page_description} />
                <meta property="og:url" content={canonical} />
                <meta property="og:image" content={social_image} />
                <meta property="og:image:width" content="1200" />
                <meta property="og:image:height" content="675" />

                <meta name="twitter:card" content="summary_large_image" />
                <meta name="twitter:title" content={page_title} />
                <meta name="twitter:description" content={page_description} />
                <meta name="twitter:image" content={social_image} />

                <link rel="icon" href="/img/logo.svg" />

                <link
                    rel="preload"
                    href="/font/plex.woff2"
                    as="font"
                    type="font/woff2"
                    crossorigin="anonymous"
                />

                <link rel="stylesheet" href="/css/tokens.css" />
                <link rel="stylesheet" href="/css/reset.css" />
                <link rel="stylesheet" href="/css/base.css" />
                <link rel="stylesheet" href="/css/layout.css" />
                <link rel="stylesheet" href="/css/components.css" />
                <link rel="stylesheet" href="/css/home.css" />
                <link rel="stylesheet" href="/css/pages.css" />

                <script type="application/ld+json">{HTMLDontEscape(structured)}</script>

                <script type="module" src="/js/main.js"></script>
            </head>

            <body>
                <a class="skip-link" href="#main">Skip to content</a>
                {banner if banner else <></>}
                <Header active={active or path} />
                <main id="main">{children}</main>
                <Footer />
            </body>
        </html>
    )
