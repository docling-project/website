import base64

from pyjsx import jsx, JSX

from website.models.papers import last_paper, paper_index, PublicationCategory

from .page import Page


def Paper(children, paper) -> JSX:
    cite_link = None
    filename = None
    if paper.bibtex:
        encoded = base64.b64encode(paper.bibtex.encode("utf-8")).decode("utf-8")
        cite_link = f"data:text/plain;base64,{encoded}"
        filename = paper.title.lower().replace(" ", "_")[:50] + ".bib"

    return (
        <div class="paper" data-category={paper.category.value}>
            <div class="card-meta">
                <span class="tag tag--muted">{paper.category.label}</span>
                {<span class="card-meta-dot"></span> if paper.venue else <></>}
                {<span class="paper-venue">{paper.venue}</span> if paper.venue else <></>}
            </div>

            <h3 class="paper-title">{paper.title}</h3>

            {
                <p class="paper-abstract">{paper.abstract}</p>
                if paper.abstract
                else <></>
            }

            <div class="paper-actions">
                {
                    <a href={f"https://arxiv.org/abs/{paper.arxiv_id}"} target="_blank" rel="noopener noreferrer">
                        arXiv
                    </a>
                    if paper.arxiv_id
                    else <></>
                }
                {
                    <a href={paper.google_scholar} target="_blank" rel="noopener noreferrer">
                        Scholar
                    </a>
                    if paper.google_scholar
                    else <></>
                }
                {<a href={cite_link} download={filename}>Cite</a> if cite_link else <></>}
                {
                    <a href={paper.url} target="_blank" rel="noopener noreferrer">View →</a>
                    if paper.url
                    else <></>
                }
            </div>
        </div>
    )


def PaperYear(children, paper_year) -> JSX:
    return (
        [<h2 class="paper-year" data-year={str(paper_year.year)}>{paper_year.year}</h2>]
        + [<Paper paper={paper} /> for paper in paper_year.papers]
    )


def PapersPage(filter: PublicationCategory = PublicationCategory.ALL) -> JSX:
    index = paper_index(filter)

    return (
        <Page
            title="Papers — Docling"
            description="Peer-reviewed publications and technical reports from the Docling team."
            path="/papers/"
            active="/papers/"
        >
            <div class="container page-header">
                <p class="section-label">Papers</p>
                <h1 class="page-title">Published work</h1>
                <p class="page-subtitle">
                    The peer-reviewed research behind Docling's layout, table and
                    conversion models.
                </p>
            </div>

            <div class="container section">
                <form class="filters" method="get">
                    {[
                        <button
                            type="submit"
                            name="filter"
                            value={option.value}
                            class={"active" if option == filter else ""}
                            aria-pressed={"true" if option == filter else "false"}
                        >
                            {option.label}
                        </button>
                        for option in PublicationCategory
                    ]}
                </form>

                {[<PaperYear paper_year={year} /> for year in index.years]}
            </div>
        </Page>
    )


def LastPaperPreview(children) -> JSX:
    paper = last_paper()
    if not paper:
        return <></>

    return (
        <a class="card" href={paper.url} target="_blank" rel="noopener noreferrer">
            <div class="card-meta">
                <span class="tag tag--purple">Paper</span>
                {<span class="card-meta-dot"></span> if paper.venue else <></>}
                {<span>{paper.venue}</span> if paper.venue else <></>}
            </div>
            <h3 class="card-title">{paper.title}</h3>
            <p class="card-body">{(paper.abstract or "")[:180]}</p>
            <span class="card-arrow" aria-hidden="true">→</span>
        </a>
    )
